{
  "name": "nano-harness",
  "version": "0.2.0",
  "description": "零依赖、模块化的 AI Agent Harness —— 终端 CLI + macOS 桌面应用 + 插件市场",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "nh": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:desktop": "tsc -p desktop/tsconfig.json",
    "build:preload": "esbuild desktop/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-desktop/preload.cjs",
    "build:ui": "vite build --config web/vite.config.ts",
    "build:all": "npm run build && npm run build:desktop && npm run build:preload && npm run build:ui",
    "pack": "npm run build:all && electron-builder --mac",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "desktop": "npm run build:all && electron dist-desktop/main.js",
    "ui:dev": "vite dev --config web/vite.config.ts",
    "mock": "node scripts/mock-server.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "harness",
    "llm",
    "cli",
    "openai-compatible",
    "deepseek",
    "zhipu",
    "ollama",
    "electron",
    "plugin-marketplace"
  ],
  "author": "xiaocube",
  "license": "MIT",
  "build": {
    "appId": "cc.xiaocube.nano-harness",
    "productName": "nano-harness",
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "dist-desktop/main.js"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "web/dist/**/*",
      "marketplace/**/*",
      "examples/**/*",
      "package.json"
    ],
    "mac": {
      "target": { "target": "dir", "arch": ["arm64"] },
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "marketplace"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.3"
  }
}
